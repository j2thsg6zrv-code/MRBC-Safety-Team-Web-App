# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The church's time zone, used to decide what "today" is on the calendar.
APP_TIME_ZONE=America/Chicago

# Automatic greeter reminder texts (optional). See src/app/api/cron/greeter-reminders/route.ts.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
