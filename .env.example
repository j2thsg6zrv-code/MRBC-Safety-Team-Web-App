# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The church's time zone, used to decide what "today" is on the calendar.
APP_TIME_ZONE=America/Chicago

# Automatic messages (optional). See src/lib/notifications.ts.
# Email through a Gmail account: use an app password, not the normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Texts through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Slide pictures (optional). With an Anthropic API key, Claude draws a flat
# illustration for each training slide; with an OpenAI key, OpenAI paints a
# cartoon instead (used when both are set). See src/lib/slidePictures.ts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
